GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Multi-Model Task Distribution
MODEL_PLANNER=gemini-2.5-flash
MODEL_ANALYZER=gemini-2.0-flash-lite
MODEL_CROSS_DOMAIN=gemini-2.5-flash
MODEL_GAP_DETECTION=gemini-2.5-flash
MODEL_HYPOTHESIS=gemini-2.5-pro
MODEL_REVIEWER=gemini-2.5-pro
MODEL_SIMULATION=gemini-2.0-flash

# Rate Limiting & Quota Management
MAX_RPM_PER_MODEL=12
MAX_RPD_PER_MODEL=1400
REQUEST_DELAY_SECONDS=0.5
ENABLE_MODEL_FAILOVER=true

DATABASE_URL=sqlite:///./hypothesis_lab.db
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
EMBEDDING_MODEL=text-embedding-004
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE=52428800
MAX_SIMULATION_ITERATIONS=3
SIMULATION_TIMEOUT=60
